# Google Gemini API key  (required for LLM-backed planner & reasoner)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-key-here

# Gemini model to use (optional — default is gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Convenience: path to your Obsidian vault root
# Used only by helper scripts, not the CLI (which requires --vault explicitly)
VAULT_PATH=/path/to/your/obsidian/vault
