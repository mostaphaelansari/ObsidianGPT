# Path to your Obsidian vault root (used by the web UI; the CLI takes --vault)
VAULT_PATH=/path/to/your/obsidian/vault

# ── Default: local Ollama ──────────────────────────────────────────────────
# Used whenever no cloud API key below is set.
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_HOST=http://localhost:11434

# ── Optional: a cloud provider ────────────────────────────────────────────
# Uncomment ONE key to use that provider instead of Ollama. If several are
# set, the first wins (Anthropic, then OpenAI, then Gemini) unless
# LLM_PROVIDER forces one: anthropic | openai | gemini | ollama.
# If the cloud call fails, ObsidianGPT falls back to Ollama.
# Install the provider's SDK first, e.g.  pip install -e .[anthropic]

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible API (OpenRouter, Groq, Together, LM Studio...):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# LLM_PROVIDER=ollama
